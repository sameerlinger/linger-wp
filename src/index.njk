---
layout: base.njk
title: Home
permalink: /index.html
---
<section class="hero">
  <div class="hero-inner">
    <p class="hero-kicker">Delightfully local weekends</p>
    <h1>Linger a while.</h1>
    <p class="hero-sub">Authentic. Low-density. Quiet. Pet friendly. Homestays and farm-stays across Coorg, near Bangalore, Bandipur and the Himalayas.</p>
    <a class="hero-cta" href="#regions">Explore properties &darr;</a>
  </div>
  <a class="scroll-hint" href="#regions" aria-label="Scroll down to explore properties">&darr;</a>
</section>

<div id="regions"></div>

{% for region in regions %}
<section class="region-section">
  <h2>{{ region.name }}</h2>
  <div class="property-grid">
  {% for slug in region.properties %}
    <a class="property-card" href="/{{ slug }}/">
      {% set cover = slug | coverImage %}
      {% if cover %}<img src="{{ cover }}" alt="{{ slug | propertyTitle(properties) }}" loading="lazy">{% endif %}
      <span class="property-card-title">{{ slug | propertyTitle(properties) }}</span>
    </a>
  {% endfor %}
  </div>
</section>
{% endfor %}

<section class="main-pages">
  <h2>More about Linger</h2>
  <ul>
  {% for p in mainpages %}
    <li><a href="/{{ p.slug }}/">{{ p.title }}</a></li>
  {% endfor %}
  </ul>
</section>
