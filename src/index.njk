---
layout: base.njk
title: Home
permalink: /index.html
---
<section class="hero" id="hero">
  <div class="hero-inner">
    <p class="hero-kicker">Delightfully local weekends</p>
    <h1>Linger a while.</h1>
    <p class="hero-sub">Authentic. Low-density. Quiet. Pet friendly. Coffee Estates, Farmstays, Wilderness Stays and homestays in the Himalayas.</p>
    <a class="hero-cta" href="#regions">Explore properties &darr;</a>
  </div>
  <a class="scroll-hint" href="#regions" aria-label="Scroll down to explore properties">&darr;</a>
</section>
<script>
(function () {
  var all = {{ heroImages.images | dump | safe }};
  if (!all.length) return;
  var hero = document.getElementById("hero");
  var last = null;
  try { last = sessionStorage.getItem("heroImage"); } catch (e) {}
  // A random handful, not the whole pool: the first is the one shown on load
  // (never the same as the previous visit's), the rest rotate in after the
  // page has finished loading, so the first view costs what it always did.
  var pool = all.slice();
  for (var i = pool.length - 1; i > 0; i--) {
    var j = Math.floor(Math.random() * (i + 1));
    var t = pool[i]; pool[i] = pool[j]; pool[j] = t;
  }
  if (pool.length > 1 && pool[0] === last) pool.push(pool.shift());
  var slides = pool.slice(0, 5);
  try { sessionStorage.setItem("heroImage", slides[0]); } catch (e) {}

  var first = new Image();
  first.onload = function () { hero.style.setProperty("--hero-image", 'url("' + slides[0] + '")'); };
  first.src = slides[0];

  var still = slides.length < 2 ||
    (window.matchMedia && matchMedia("(prefers-reduced-motion: reduce)").matches) ||
    (navigator.connection && navigator.connection.saveData);
  if (still) return;

  var index = 0, shown = null;
  function next() {
    if (document.hidden) return;
    var src = slides[(index + 1) % slides.length];
    var img = new Image();
    img.onload = function () {
      index = (index + 1) % slides.length;
      var layer = document.createElement("div");
      layer.className = "hero-slide";
      layer.style.backgroundImage = 'url("' + src + '")';
      hero.insertBefore(layer, hero.firstChild);
      layer.offsetWidth; // start the fade from opacity 0
      layer.classList.add("is-visible");
      if (shown) { var old = shown; setTimeout(function () { old.remove(); }, 1600); }
      shown = layer;
    };
    img.src = src;
  }
  window.addEventListener("load", function () { setInterval(next, 6000); });
})();
</script>

{% if collections.destinations.length %}
<nav class="destination-links region-section" aria-label="Browse by destination">
  <h2>Find a stay by destination</h2>
  <ul>
    {% for d in collections.destinations %}<li><a href="{{ d.url }}">{{ d.title }}</a></li>{% endfor %}
  </ul>
</nav>
{% endif %}
<div id="regions"></div>

{% for region in collections.regions %}
<section class="region-section">
  <h2>{{ region.name }}</h2>
  <div class="property-grid" id="grid-{{ region.slug | slugify }}"{% if region.color %} style="--category-bg: {{ region.color }}"{% endif %}>
  {% for slug in region.properties %}
    <a class="property-card" href="/{{ slug }}/">
      {% set cover = slug | coverImage %}
      {% set location = slug | pageLocation %}
      {% if cover %}
      <div class="property-card-media">
        <img src="{{ cover }}" alt="{{ slug | propertyTitle(properties) }}" loading="lazy">
        {% if location %}<span class="property-card-location">{{ location }}</span>{% endif %}
      </div>
      {% endif %}
      <span class="property-card-title">{{ slug | propertyTitle(properties) }}</span>
      {% set summary = slug | pageSummary %}
      {% if summary %}<span class="property-card-summary">{{ summary }}</span>{% endif %}
    </a>
  {% endfor %}
  </div>
</section>
<script>
(function () {
  var grid = document.getElementById("grid-{{ region.slug | slugify }}");
  var cards = Array.prototype.slice.call(grid.children);
  for (var i = cards.length - 1; i > 0; i--) {
    var j = Math.floor(Math.random() * (i + 1));
    var tmp = cards[i]; cards[i] = cards[j]; cards[j] = tmp;
  }
  cards.forEach(function (c) { grid.appendChild(c); });
})();
</script>
{% endfor %}

<section class="main-pages">
  <h2>More about Linger</h2>
  <ul>
  {% for p in mainpages %}
    <li><a href="/{{ p.slug }}/">{{ p.title }}</a></li>
  {% endfor %}
  </ul>
</section>
