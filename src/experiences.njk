---
layout: base.njk
title: Experiences
permalink: /experiences/index.html
seo_description: Nature weekends, farm days and other curated experiences at Linger, hosted with naturalists and local partners.
---
{% set firstCover = null %}
{% for s in collections.experienceSections %}{% if not firstCover %}{% set firstCover = s.items[0].slug | coverImage %}{% endif %}{% endfor %}
<section class="hero hero-short"{% if firstCover %} style="--hero-image: url('{{ firstCover }}')"{% endif %}>
  <div class="hero-inner">
    <p class="hero-kicker">Delightfully local</p>
    <h1>Experiences</h1>
    <p class="hero-sub">Weekends and days out with naturalists and local partners, hosted at our places.</p>
  </div>
</section>

{% for section in collections.experienceSections %}
<section class="region-section">
  <h2>{{ section.name }}</h2>
  {% if section.description %}<p class="region-intro">{{ section.description }}</p>{% endif %}
  <div class="property-grid"{% if section.color %} style="--category-bg: {{ section.color }}"{% endif %}>
  {% for e in section.items %}
    <a class="property-card" href="/{{ e.slug }}/">
      {% set cover = e.slug | coverImage %}
      {% set location = e.slug | pageLocation %}
      {% if cover %}
      <div class="property-card-media">
        <img src="{{ cover }}" alt="{{ e.title }}" loading="lazy">
        {% if location %}<span class="property-card-location">{{ location }}</span>{% endif %}
      </div>
      {% endif %}
      <span class="property-card-title">{{ e.title }}</span>
      <span class="property-card-date">{{ e.dateText or "Date to be announced" }}</span>
      {% set summary = e.slug | pageSummary %}
      {% if summary %}<span class="property-card-summary">{{ summary }}</span>{% endif %}
    </a>
  {% endfor %}
  </div>
</section>
{% endfor %}

<section class="enquiry" id="interested">
  <div class="enquiry-inner">
    <h2>I'm interested</h2>
    <p class="enquiry-sub">Share your interest - we'll let you know when the next one happens. Pick an experience and leave your details and we'll be in touch. No payment now.</p>
    <form class="interest-form" data-page-title="Experiences">
      <div class="enquiry-row">
        <label>I'm interested in<select name="event" required>
          {% for e in collections.experienceList %}
          <option value="{{ e.title }}"{% if e.date %} data-date="{{ e.dateText }}"{% endif %}{% if e.partner %} data-partner="{{ e.partner }}"{% endif %}>{{ e.title }}{% if e.dateText %} ({{ e.dateText }}){% endif %}</option>
          {% endfor %}
          <option value="Something else / anything coming up">Something else / anything coming up</option>
        </select></label>
      </div>
      <div class="enquiry-row">
        <label>Name<input type="text" name="name" required autocomplete="name" maxlength="200"></label>
        <label>Phone<input type="tel" name="phone" required autocomplete="tel" minlength="6" maxlength="30"></label>
      </div>
      <div class="enquiry-row">
        <label>Email<input type="email" name="email" required autocomplete="email" maxlength="200"></label>
        <label>Number of people<input type="number" name="people" required min="1" max="50" step="1" value="2"></label>
      </div>
      <input type="text" name="company" class="enquiry-hp" tabindex="-1" autocomplete="off" aria-hidden="true">
      <button type="submit" class="enquiry-submit">Count me in</button>
      <p class="enquiry-status" role="status"></p>
    </form>
  </div>
</section>
<a href="#interested" class="query-floater">Send Query <span aria-hidden="true">&darr;</span></a>
