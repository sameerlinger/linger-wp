---
layout: base.njk
---
<div class="prose">
{{ content | safe }}
</div>
{% if page.fileSlug | isProperty(properties) %}
<section class="enquiry">
  <div class="enquiry-inner">
    {% if page.fileSlug in dormantSlugs %}
    <h2>Check availability</h2>
    <p class="enquiry-sub">This property isn't currently taking bookings.</p>
    {% else %}
    <h2>Check availability</h2>
    <p class="enquiry-sub">Tell us your dates and we'll get back to you by email.</p>
    <form class="enquiry-form">
      <div class="enquiry-row">
        {# Starts on this page's own property; "any" is handled by LingerApp's
           /api/public/enquiry as an open enquiry (no one property to check). #}
        <label>Property<select name="property">
          <option value="any">Any property</option>
          {% for p in properties | bookableProperties(dormantSlugs) %}
          <option value="{{ p.slug }}"{% if p.slug == page.fileSlug %} selected{% endif %}>{{ p.title }}</option>
          {% endfor %}
        </select></label>
      </div>
      <div class="enquiry-row">
        <label>Name<input type="text" name="name" required autocomplete="name"></label>
        <label>Email<input type="email" name="email" required autocomplete="email"></label>
        <label>Phone (optional)<input type="tel" name="phone" autocomplete="tel" maxlength="30"></label>
      </div>
      <div class="enquiry-row">
        <label>Check-in<input type="date" name="checkIn" required></label>
        <label>Check-out<input type="date" name="checkOut" required></label>
        <label>Number of people<input type="number" name="guests" min="1" max="50" step="1" required></label>
      </div>
      <!-- Honeypot: hidden from real visitors, invisible to screen readers, but a
           bot filling every field will fill this too — see the server-side check. -->
      <input type="text" name="company" class="enquiry-hp" tabindex="-1" autocomplete="off" aria-hidden="true">
      <button type="submit" class="enquiry-submit">Check availability</button>
      <p class="enquiry-status" role="status"></p>
    </form>
    {% endif %}
  </div>
</section>
{% endif %}
