---
layout: base.njk
---
<article class="post">
  <p class="post-back"><a href="/blog/">&larr; Back to the blog</a></p>
  <h1>{{ title }}</h1>
  <p class="post-meta">
    <time datetime="{{ date }}">{{ date | dateDisplay }}</time>
    {% if categories.length %}
    <span class="post-categories">
      {% for c in categories %}<span class="category-pill">{{ c }}</span>{% endfor %}
    </span>
    {% endif %}
  </p>
  <div class="post-body">
    {{ content | safe }}
  </div>
</article>
