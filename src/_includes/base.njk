<div class="lightbox" id="lightbox">
  <button type="button" class="lightbox-close" aria-label="Close">&times;</button>
  <img src="" alt="">
</div>
<script>
document.querySelectorAll(".carousel-track").forEach(function (track) {
  var prev = track.parentElement.querySelector(".carousel-prev");
  var next = track.parentElement.querySelector(".carousel-next");
  function step() { return track.querySelector("img") ? track.querySelector("img").getBoundingClientRect().width + 12 : 200; }
  if (prev) prev.addEventListener("click", function () { track.scrollBy({ left: -step(), behavior: "smooth" }); });
  if (next) next.addEventListener("click", function () { track.scrollBy({ left: step(), behavior: "smooth" }); });
});

var lightbox = document.getElementById("lightbox");
var lightboxImg = lightbox.querySelector("img");
function closeLightbox() {
  lightbox.classList.remove("open");
  lightboxImg.src = "";
}
document.querySelectorAll(".lightbox-trigger").forEach(function (a) {
  a.addEventListener("click", function (e) {
    e.preventDefault();
    var img = a.querySelector("img");
    lightboxImg.src = a.getAttribute("href");
    lightboxImg.alt = img ? img.alt : "";
    lightbox.classList.add("open");
  });
});
lightbox.querySelector(".lightbox-close").addEventListener("click", closeLightbox);
lightbox.addEventListener("click", function (e) {
  if (e.target === lightbox) closeLightbox();
});
document.addEventListener("keydown", function (e) {
  if (e.key === "Escape") closeLightbox();
});
</script>
